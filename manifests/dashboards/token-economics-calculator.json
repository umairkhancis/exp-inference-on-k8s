{
  "uid": "token-calc",
  "title": "Token Economics — Calculator (what-if)",
  "tags": ["llm", "cost", "business", "calculator"],
  "timezone": "browser",
  "refresh": "",
  "time": { "from": "now-24h", "to": "now" },
  "schemaVersion": 39,
  "editable": true,
  "templating": {
    "list": [
      {
        "type": "textbox",
        "name": "in_tok_hr",
        "label": "Input tokens / hour",
        "query": "200000",
        "current": { "text": "200000", "value": "200000" },
        "options": [{ "text": "200000", "value": "200000", "selected": true }]
      },
      {
        "type": "textbox",
        "name": "out_tok_hr",
        "label": "Output tokens / hour",
        "query": "1700000",
        "current": { "text": "1700000", "value": "1700000" },
        "options": [{ "text": "1700000", "value": "1700000", "selected": true }]
      },
      {
        "type": "textbox",
        "name": "claude_in",
        "label": "Claude $ / M input tokens",
        "query": "3.00",
        "current": { "text": "3.00", "value": "3.00" },
        "options": [{ "text": "3.00", "value": "3.00", "selected": true }]
      },
      {
        "type": "textbox",
        "name": "claude_out",
        "label": "Claude $ / M output tokens",
        "query": "15.00",
        "current": { "text": "15.00", "value": "15.00" },
        "options": [{ "text": "15.00", "value": "15.00", "selected": true }]
      },
      {
        "type": "textbox",
        "name": "gpu_hr",
        "label": "GPU $ / hour (flat)",
        "query": "2.49",
        "current": { "text": "2.49", "value": "2.49" },
        "options": [{ "text": "2.49", "value": "2.49", "selected": true }]
      },
      {
        "type": "textbox",
        "name": "tz_offset",
        "label": "UTC offset (business-day curve)",
        "query": "5",
        "current": { "text": "5", "value": "5" },
        "options": [{ "text": "5", "value": "5", "selected": true }]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "",
      "gridPos": { "h": 2, "w": 24, "x": 0, "y": 0 },
      "options": {
        "mode": "markdown",
        "content": "### What-if calculator — no live data. Enter your expected token volume and prices in the variables above. Claude charges **per token**: the bill scales with usage. Self-hosting costs a **flat GPU-hour rate**: the bill scales only with time. All totals below are for the time window selected in the top-right picker."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Claude bill for this window (per-token × assumed usage)",
      "description": "Assumed tokens/hour × hours in window × Claude per-token prices.",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 2 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "vector(($in_tok_hr * $claude_in + $out_tok_hr * $claude_out) / 1e6 * $__range_s / 3600)",
          "legendFormat": "Claude bill",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "color": { "mode": "fixed", "fixedColor": "red" }
        },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "none", "textMode": "value" }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Self-hosted bill for this window (hours × flat GPU rate)",
      "description": "Hours in the selected window × flat GPU rate. Does not change with token volume.",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 2 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "vector($gpu_hr * $__range_s / 3600)",
          "legendFormat": "Self-hosted bill",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "color": { "mode": "fixed", "fixedColor": "green" }
        },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "none", "textMode": "value" }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Savings multiple — Claude ÷ self-hosted",
      "description": "How many times more the same usage costs on per-token pricing. Independent of window length. Target: ≥ 10×.",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 2 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "vector((($in_tok_hr * $claude_in + $out_tok_hr * $claude_out) / 1e6) / $gpu_hr)",
          "legendFormat": "multiple",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix:×",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "green", "value": 10 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "none", "textMode": "value" }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Spend rate, $ per hour — Claude bills the meter, self-hosted bills the clock",
      "description": "Claude spend modeled over a business day: 80% of the volume lands in the 8 working hours (09–17 local), mirroring the system-design demand model — the daily average equals your assumed tokens/hour. The self-hosted line is flat at the GPU rate no matter what. Wherever red is above green, per-token pricing is losing money.",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "vector(($in_tok_hr * $claude_in + $out_tok_hr * $claude_out) / 1e6) * (0.3 + 2.1 * ((((hour() + $tz_offset) % 24) >= bool 9) * ((((hour() + $tz_offset) % 24)) < bool 17)))",
          "legendFormat": "Claude (per-token — moves with usage)"
        },
        {
          "refId": "B",
          "expr": "vector($gpu_hr)",
          "legendFormat": "Self-hosted (flat rate)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "custom": { "fillOpacity": 12, "lineWidth": 2, "showPoints": "never" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Claude (per-token — moves with usage)" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          },
          {
            "matcher": { "id": "byName", "options": "Self-hosted (flat rate)" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "mean"] },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Tokens in this window (assumed)",
      "description": "Assumed tokens/hour × hours in the selected window.",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "vector($in_tok_hr * $__range_s / 3600)",
          "legendFormat": "input tokens",
          "instant": true
        },
        {
          "refId": "B",
          "expr": "vector($out_tok_hr * $__range_s / 3600)",
          "legendFormat": "output tokens",
          "instant": true
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 1 }, "overrides": [] },
      "options": { "colorMode": "none", "graphMode": "none", "textMode": "value_and_name" }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Claude cost per M tokens (blended)",
      "description": "Input+output blended rate at the entered prices — constant regardless of volume.",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "vector(($in_tok_hr * $claude_in + $out_tok_hr * $claude_out) / ($in_tok_hr + $out_tok_hr))",
          "legendFormat": "Claude $/M tok",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "currencyUSD", "decimals": 2, "color": { "mode": "fixed", "fixedColor": "red" } },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "none", "textMode": "value" }
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Self-hosted cost per M tokens — falls as usage grows",
      "description": "Flat GPU rate ÷ assumed token volume. The busier the box, the cheaper each token.",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "vector($gpu_hr * 1e6 / ($in_tok_hr + $out_tok_hr))",
          "legendFormat": "self-hosted $/M tok",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "currencyUSD", "decimals": 2, "color": { "mode": "fixed", "fixedColor": "green" } },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "none", "textMode": "value" }
    }
  ]
}
